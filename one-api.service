[Unit]
Description=DeepSeek One API Service
Wants=network-online.target
After=network-online.target mysql.service redis-server.service
Requires=mysql.service redis-server.service

[Service]
Type=simple
User=oneapi
Group=oneapi
WorkingDirectory=/opt/one-api
EnvironmentFile=/etc/one-api/one-api.env
ExecStart=/opt/one-api/one-api --log-dir /var/lib/one-api/logs
Restart=on-failure
RestartSec=5
StateDirectory=one-api
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
